DB_PATH=./data.sqlite

# --- Mercado Pago (entorno de PRUEBA / TEST) ---
# Access Token de PRUEBA de tu aplicación (empieza con TEST-...).
# Obtenelo en: https://www.mercadopago.com.ar/developers/panel/app -> Credenciales de prueba
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxx
# URL del frontend para las back_urls de Checkout Pro.
FRONTEND_URL=http://localhost:5173
# (Opcional) URL pública para recibir webhooks de Mercado Pago.
# MP_NOTIFICATION_URL=https://tu-dominio/api/compras/webhook

# --- Envío de correos de confirmación (con comprobante PDF adjunto) ---
# Se envía un correo cuando la compra queda confirmada:
#   - Efectivo: al registrarse la compra (se abona en boletería).
#   - Tarjeta: cuando Mercado Pago aprueba el pago.
# Si MAIL_USER o MAIL_PASS quedan vacíos, NO se envían correos reales
# (se usa un mailer de consola que solo loguea).
#
# Cuenta de Gmail que ENVÍA los correos. Necesitás verificación en 2 pasos
# activada y una "contraseña de aplicación" (NO tu contraseña normal):
#   https://myaccount.google.com/apppasswords
MAIL_SERVICE=gmail
MAIL_USER=iswg1tp6@gmail.com
MAIL_PASS=kgic dboq onvx bogd
# Remitente que figura en el correo (opcional; por defecto usa MAIL_USER).
MAIL_FROM=EcoHarmony Park <iswg1tp6@gmail.com>
# Correo que RECIBE las confirmaciones. Si se define, TODAS las confirmaciones
# se envían a esta casilla (útil para pruebas, ya que el usuario de la app es de prueba).
MAIL_TO=destino@gmail.com
# (Opcional) SMTP propio en lugar de Gmail. Si definís MAIL_HOST, se ignora MAIL_SERVICE.
# MAIL_HOST=smtp.tu-dominio.com
# MAIL_PORT=465
# MAIL_SECURE=true
